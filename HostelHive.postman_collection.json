            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('chatSessionId', body.data.sessionId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chatbot/message",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What time is check-in and what's the WiFi password?\"\n}"
        }
      },
      "description": "Requires GROQ_API_KEY set in .env. Reply is grounded only in this hostel's chatbot-info form (request 27)."
    },
    {
      "name": "30. Resident asks a follow-up (same session \u2014 tests context memory)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chatbot/message",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"And what about check-out?\",\n  \"sessionId\": \"{{chatSessionId}}\"\n}"
        }
      },
      "description": "Doesn't repeat 'hostel' in the question \u2014 if context works, the bot still knows which hostel/topic this refers to from the previous turn."
    },
    {
      "name": "31. Get chat history for a session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/chatbot/history?sessionId={{chatSessionId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      }
    },
    {
      "name": "32. List all chat sessions for the resident",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/chatbot/sessions",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      }
    },
    {
      "name": "33. Resident's notification inbox",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "description": "Should show a 'Booking approved' and 'Rent due' notification from earlier requests (19, 21)."
    },
    {
      "name": "34. Unread notification count",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications/unread-count",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      }
    },
    {
      "name": "35. Mark all notifications as read",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/notifications/read-all",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      }
    },
    {
      "name": "36. Verify a payment's blockchain record",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/blockchain/Payment/{{paymentId}}/verify",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "description": "Set the {{paymentId}} variable to a real Payment _id after a checkout settles via webhook. Returns hash, blockRef, network, and explorerUrl (a real PolygonScan link if BLOCKCHAIN_RPC_URL/BLOCKCHAIN_PRIVATE_KEY are set, null otherwise)."
    },
    {
      "name": "37. List all bookings for hostel (Admin)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/bookings/hostel/{{hostelId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "description": "Returns all bookings for rooms belonging to {{hostelId}} with optional ?status= filter."
    },
    {
      "name": "38. List all invoices for hostel (Admin)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/invoices/hostel/{{hostelId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "description": "Returns all invoices for bookings in {{hostelId}} with populated student and room info and optional ?status= filter."
    },
    {
      "name": "39. List all cleaning tasks for hostel (Admin)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cleaning-tasks/hostel/{{hostelId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "description": "Returns all cleaning tasks for rooms in {{hostelId}} with assigned staff and room details and optional ?status= filter."
    }
  ]
