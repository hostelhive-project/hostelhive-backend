# Server
PORT=5000
NODE_ENV=development

# Database
# Use an initialized replica set (see docs/LOCAL_MONGODB_SETUP.md), or Atlas.
MONGO_URI=mongodb://127.0.0.1:27018/hostelhive?replicaSet=hostelhiveDev

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# Email verification and password reset (Gmail SMTP)
# Use a Google App Password, not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional; defaults to "HostelHive <EMAIL_USER>".
EMAIL_FROM=

# Payment Gateway — Stripe Connect
# Get these from https://dashboard.stripe.com/test/apikeys (test mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Get this after creating a webhook endpoint at https://dashboard.stripe.com/test/webhooks
# (point it at POST {your_api_url}/api/payments/webhook, events: checkout.session.completed,
# checkout.session.expired, payment_intent.payment_failed, account.updated,
# charge.refunded, charge.dispute.created, charge.dispute.updated,
# charge.dispute.closed)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Publishable key is safe to expose to the frontend; included here only so the
# backend can hand it to the client via a config endpoint if useful.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Where the Admin's browser lands during/after Stripe Connect onboarding
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/admin/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/admin/stripe/complete
# Where a resident's browser lands after paying/cancelling a checkout
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel
# Currency conversion for Stripe Checkout (amounts are canonical PKR in database)
PKR_PER_USD=280

# AI Chatbot — Groq (free tier, OpenAI-compatible API)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Before/after cleaning assessment uses the SAME server-only Groq key, a separate vision model.
# Keep the Groq account on its Free plan; app limits cannot override provider billing settings.
CLEANING_AI_ENABLED=true
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Global daily request cap (UTC), including retries. Allowed 0-20; 0 disables calls.
CLEANING_AI_DAILY_LIMIT=20
# Calls are spaced at least 65 seconds apart; at most 2 attempts per task.

# Blockchain Ledger — Polygon Amoy testnet (free)
# In development/test, leave both blank to run in simulated mode (hash-only, no real chain — still
# fully functional, just no public explorer link). To go real:
#   1. Create a free wallet (e.g. MetaMask) — never reuse a wallet with real funds.
#   2. Get free test MATIC from a faucet, e.g. https://faucet.polygon.technology/
#   3. Get a free RPC URL from https://www.alchemy.com or https://www.infura.io (Polygon Amoy network)
# BLOCKCHAIN_RPC_URL is that RPC endpoint; BLOCKCHAIN_PRIVATE_KEY is the test
# wallet's private key (from MetaMask: Account details > Show private key).
# This wallet only ever holds worthless testnet tokens — never put a real
# funded wallet's key here.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

# Firebase Cloud Messaging (Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ImageKit CDN (Photo uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/pvafewi0b

# Audit hardening: see docs/BACKEND_HARDENING_SETUP.md before deployment.
# MongoDB must support transactions (replica set or Atlas); standalone is unsupported.
BILLING_TIMEZONE=Asia/Karachi
# Public-image simulation is development-only. Identity documents always require ImageKit.
ALLOW_SIMULATED_UPLOADS=false

# CORS
CLIENT_WEB_ORIGIN=http://localhost:3000
CLIENT_MOBILE_ORIGIN=*
