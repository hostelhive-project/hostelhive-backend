    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.1.1",
    "helmet": "^7.1.0",
    "imagekit": "^6.0.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.3.1",
    "stripe": "^15.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
